# Environment and config secrets
# Ignoring a file does not remove earlier versions from Git history.
# Use config/settings.example.json (tracked, no secrets) as the template.
.env
config/settings.json

# Offline speech model (~55MB, downloaded by the installer — see requirements.txt)
models_local/

# Python cache & build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
node_modules/

# Translation cache (rebuilt at runtime; device-local)
cache/

# Log files
logs/
*.log

# Temp audio / image files
*.wav
*.jpg
*.jpeg
*.png

# Device-local persistent state and generated deployment locks
runtime/
deployment.lock.txt
