{
  "language": "eng",
  "tts_rate": 130,
  "tts_volume": 1.0,
  "tts_engine": "gtts",
  "morse_port": "/dev/ttyACM0",
  "morse_dot_max_ms": 400,
  "morse_dash_min_ms": 400,
  "morse_letter_gap_ms": 1500,
  "morse_word_gap_ms": 3000,
  "gemini_api_key": "YOUR_GEMINI_API_KEY",
  "openai_api_key": "",
  "cohere_api_key": "",
  "pinecone_api_key": "",
  "groq_api_key": "YOUR_GROQ_API_KEY",
  "anthropic_api_key": "",
  "logfire_token": "",
  "gemini_model_name": "gemini-3.5-flash-lite",
  "embedding_provider": "gemini",
  "vector_store_type": "faiss",
  "use_cohere_rerank": false,
  "bone_device": "plughw:4,0",
  "speaker_device": "plughw:3,0",
  "yolo_confidence": 0.75,
  "yolo_model_path": "/mnt/aet_usb/models/yolov8m.pt",
  "object_detection_display": false,
  "ocr_default_lang": "eng",
  "ocr_model_name": "datalab-to/surya-ocr-2",
  "ocr_device_map": "auto",
  "ocr_max_tokens": 512,
  "ocr_preload": false,
  "ocr_prompt": "Read all text present in this image clearly and accurately.",
  "gps_baud": 9600,
  "gps_port": "/dev/serial0",
  "use_gpio": true,
  "gps_test_lat": 20.9467,
  "gps_test_lon": 72.952,
  "allow_ip_geolocation": true,
  "gesture_confidence": 0.85,
  "gesture_backend": "auto",
  "gesture_allow_unsafe_tasks": true,
  "gesture_camera_index": 0,
  "gesture_display": false,
  "gesture_debounce_ms": 600,
  "gesture_cooldown_ms": 1500,
  "emotion_consecutive_threshold": 2,
  "offline_model_path": "models/tinyllama-1.1b.Q4_K_M.gguf",

  "offline_model_preload": false,
  "offline_load_timeout_s": 60,

  "groq_timeout_s": 6.0,
  "openai_timeout_s": 8.0,
  "gemini_timeout_s": 10.0,
  "ai_race_timeout_s": 10.0,

  "mic_device": "default",
  "mic_input_index": null,
  "vad_aggressiveness": 2,
  "voice_timeout_seconds": 8,
  "voice_record_max_seconds": 8,
  "voice_recording_dir": "data/recordings",
  "voice_keep_recordings": 20,

  "object_detection_camera_index": 0,
  "object_detection_max_seconds": 120,
  "yolo_imgsz": 640,

  "privacy": {
